---
interface Props {
  alcool: number;
  soft: number;
  drogue: number;
  manger: number;
}

const { alcool, soft, drogue, manger } = Astro.props;
const total = alcool + soft + drogue + manger;

const chartData = {
  labels: [`Alcool (${alcool})`, `Soft (${soft})`, `Drogue (${drogue})`, `Manger (${manger})`],
  data: [alcool, soft, drogue, manger],
  colors: ['#93c5fd', '#86efac', '#c4b5fd', '#fcd34d'],
};
---

<div class="glass-card p-6 rounded-2xl">
  {total === 0 ? (
    <p class="text-center text-white/30 py-8 text-sm">Aucun stock pour le moment.</p>
  ) : (
    <>
      <div class="flex justify-center mb-4">
        <canvas id="stock-pie-chart" width="220" height="220" style="max-width: 220px;"></canvas>
      </div>
      <div class="grid grid-cols-2 gap-2 mt-2">
        {[
          { label: 'Alcool', color: '#93c5fd', count: alcool },
          { label: 'Soft', color: '#86efac', count: soft },
          { label: 'Drogue', color: '#c4b5fd', count: drogue },
          { label: 'Manger', color: '#fcd34d', count: manger },
        ].map(item => (
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full shrink-0" style={`background: ${item.color}`}></div>
            <span class="text-sm text-white/50 flex-1">{item.label}</span>
            <span class="text-sm text-white/30">{item.count}</span>
          </div>
        ))}
      </div>
    </>
  )}
</div>

<script is:inline define:vars={{ chartData, total }}>
  if (total > 0) {
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
    script.onload = () => {
      const canvas = document.getElementById('stock-pie-chart');
      if (!canvas) return;
      new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: chartData.labels,
          datasets: [{
            data: chartData.data,
            backgroundColor: chartData.colors,
            borderColor: '#0e0e0e',
            borderWidth: 3,
          }],
        },
        options: {
          responsive: false,
          cutout: '55%',
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx) => {
                  const pct = Math.round((ctx.parsed / chartData.data.reduce((a, b) => a + b, 0)) * 100);
                  return ` ${ctx.label} — ${pct}%`;
                },
              },
            },
          },
        },
      });
    };
    document.head.appendChild(script);
  }
</script>
