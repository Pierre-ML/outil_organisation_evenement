---
interface Props {
  user: Record<string, any>;
}

const { user } = Astro.props;
const pb_url = import.meta.env.PUBLIC_POCKETBASE_URL;
const avatarUrl = user.avatar
  ? `${pb_url}/api/files/users/${user.id}/${user.avatar}`
  : null;

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/stock', label: 'Stock' },
  { href: '/lieux', label: 'Lieux' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50" style="background: rgba(14,14,14,0.88); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.06);">
  <div class="max-w-6xl mx-auto px-5 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/dashboard" class="text-lg font-black tracking-tight text-white">SoiréeApp</a>

    <!-- Desktop nav -->
    <div class="hidden sm:flex items-center gap-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
            currentPath === href
              ? 'text-white bg-white/8'
              : 'text-white/50 hover:text-white hover:bg-white/5'
          }`}
        >
          {label}
        </a>
      ))}
      {user.admin && (
        <a
          href="/admin"
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
            currentPath === '/admin'
              ? 'text-white bg-white/8'
              : 'text-white/40 hover:text-white hover:bg-white/5'
          }`}
        >
          Admin
        </a>
      )}
    </div>

    <!-- Desktop right -->
    <div class="hidden sm:flex items-center gap-3">
      <a href="/profil" class="flex items-center gap-2.5 group">
        {avatarUrl ? (
          <img
            src={avatarUrl}
            alt={user.name}
            class="w-8 h-8 rounded-full object-cover"
            style="border: 1px solid rgba(255,255,255,0.12);"
          />
        ) : (
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.12);">
            {user.name?.[0]?.toUpperCase() ?? 'U'}
          </div>
        )}
        <span class="text-sm text-white/55 group-hover:text-white transition-colors">{user.name}</span>
      </a>
      <button
        id="logout-btn"
        class="px-3 py-1.5 rounded-lg text-sm text-white/30 hover:text-white/70 transition-colors"
      >
        Déconnexion
      </button>
    </div>

    <!-- Mobile hamburger -->
    <button id="hamburger" class="sm:hidden p-2 rounded-lg hover:bg-white/5 transition-colors" aria-label="Menu">
      <div class="w-5 space-y-1.5">
        <span class="block h-0.5 bg-white/60 rounded transition-all" id="h-line1"></span>
        <span class="block h-0.5 bg-white/60 rounded transition-all" id="h-line2"></span>
        <span class="block h-0.5 bg-white/60 rounded transition-all" id="h-line3"></span>
      </div>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="sm:hidden hidden px-4 pb-4"
    style="background: rgba(14,14,14,0.98); border-top: 1px solid rgba(255,255,255,0.06);"
  >
    <div class="flex flex-col gap-1 pt-3">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="px-4 py-3 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-colors font-medium">
          {label}
        </a>
      ))}
      {user.admin && (
        <a href="/admin" class="px-4 py-3 rounded-xl text-white/40 hover:text-white hover:bg-white/5 transition-colors font-medium">
          Admin
        </a>
      )}
      <a href="/profil" class="px-4 py-3 rounded-xl text-white/60 hover:text-white hover:bg-white/5 transition-colors font-medium">
        Mon profil
      </a>
      <button
        id="logout-btn-mobile"
        class="text-left px-4 py-3 rounded-xl text-white/30 hover:text-white/60 hover:bg-white/5 transition-colors font-medium"
      >
        Déconnexion
      </button>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('hamburger')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  let menuOpen = false;

  hamburger.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu.classList.toggle('hidden', !menuOpen);
  });

  function logout() {
    document.cookie = 'pb_auth=; path=/; max-age=0; SameSite=Strict';
    window.location.href = '/login';
  }

  document.getElementById('logout-btn')?.addEventListener('click', logout);
  document.getElementById('logout-btn-mobile')?.addEventListener('click', logout);
</script>
