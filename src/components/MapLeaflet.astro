---
interface Lieu {
  id: string;
  nom: string;
  adresse: string;
  img?: string;
}

interface Props {
  lieux: Lieu[];
  pbUrl: string;
}

const { lieux, pbUrl } = Astro.props;
const lieuxJson = JSON.stringify(lieux);
---

<div>
  <div
    id="map"
    class="rounded-2xl overflow-hidden"
    style="height: 350px; border: 1px solid rgba(255,255,255,0.08);"
  ></div>
  <p class="text-xs text-gray-600 mt-2 text-center">Carte © OpenStreetMap contributors</p>
</div>

<script is:inline define:vars={{ lieuxJson, pbUrl }}>
  const lieux = JSON.parse(lieuxJson);

  // Load Leaflet CSS
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
  document.head.appendChild(link);

  // Load Leaflet JS
  const script = document.createElement('script');
  script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  script.onload = async () => {
    const L = window.L;
    const map = L.map('map', {
      center: [46.603354, 1.888334],
      zoom: 5,
      zoomControl: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    // Custom marker icon
    const icon = L.icon({
      iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
      iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
      shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    const bounds = [];

    for (const lieu of lieux) {
      try {
        const query = encodeURIComponent(lieu.adresse);
        const res = await fetch(
          `https://nominatim.openstreetmap.org/search?q=${query}&format=json&limit=1`,
          { headers: { 'Accept-Language': 'fr' } }
        );
        const results = await res.json();
        if (!results.length) continue;

        const { lat, lon } = results[0];
        const imgHtml = lieu.img
          ? `<img src="${pbUrl}/api/files/lieux/${lieu.id}/${lieu.img}" style="width:100%;height:100px;object-fit:cover;border-radius:8px;margin-bottom:8px;" />`
          : '';

        const marker = L.marker([parseFloat(lat), parseFloat(lon)], { icon }).addTo(map);
        marker.bindPopup(`
          <div style="min-width:160px;">
            ${imgHtml}
            <strong style="color:#0d0d0d;">${lieu.nom}</strong><br/>
            <span style="font-size:12px;color:#555;">${lieu.adresse}</span>
          </div>
        `);
        bounds.push([parseFloat(lat), parseFloat(lon)]);
      } catch {
        // Geocoding failed for this address — skip
      }
    }

    if (bounds.length === 1) {
      map.setView(bounds[0], 14);
    } else if (bounds.length > 1) {
      map.fitBounds(bounds, { padding: [40, 40] });
    }
  };
  document.head.appendChild(script);
</script>
