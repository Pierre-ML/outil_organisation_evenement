---
import Layout from '../layouts/Layout.astro';
import StockChart from '../components/StockChart.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

const TYPE_LABELS: Record<string, string> = { alcool: 'Alcool', soft: 'Soft', drogue: 'Drogue', manger: 'Manger' };
const TYPE_INITIALS: Record<string, string> = { alcool: 'A', soft: 'S', drogue: 'D', manger: 'M' };

let myStock: any[] = [];
let allStock: any[] = [];
let usersMap: Record<string, string> = {};

try {
  myStock = await pb.collection('stockage').getFullList({ filter: `qui = "${user.id}"`, sort: '-created' });
} catch {}

try {
  allStock = await pb.collection('stockage').getFullList({ expand: 'qui' });
  for (const s of allStock) {
    if (s.expand?.qui?.name) usersMap[s.qui] = s.expand.qui.name;
  }
} catch {}

const agg = { alcool: 0, soft: 0, drogue: 0, manger: 0 };
for (const s of allStock) {
  const types = Array.isArray(s.type) ? s.type : [s.type];
  for (const t of types) {
    if (t in agg) agg[t as keyof typeof agg] += s.combien;
  }
}

const TYPE_SHADES: Record<string, string> = { alcool: '#ffffff', soft: '#888888', drogue: '#555555', manger: '#333333' };
const breakdown = (['alcool', 'soft', 'drogue', 'manger'] as const)
  .map((type) => ({
    type, shade: TYPE_SHADES[type], label: TYPE_LABELS[type],
    total: agg[type],
    items: allStock.filter((s) => (Array.isArray(s.type) ? s.type : [s.type]).includes(type)),
  }))
  .filter((g) => g.items.length > 0);

const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
---

<Layout title="Stock" user={user}>
  <div class="py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-1 text-white">Stock</h1>
      <p class="text-white/40">Gère ce que tu ramènes à la soirée.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- MON STOCK -->
      <div>
        <p class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">Mon stock</p>

        <div class="glass-card p-6 rounded-2xl mb-5">
          <h3 class="font-semibold mb-4 text-white">Ajouter un article</h3>
          <div id="form-error" class="hidden mb-4 p-3 rounded-xl text-sm" style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: rgba(255,255,255,0.65);"></div>
          <div id="form-success" class="hidden mb-4 p-3 rounded-xl text-sm" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.8);"></div>

          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="label" for="stock-nom">Nom</label>
                <input type="text" id="stock-nom" placeholder="Ex: Ricard" class="input-field" />
              </div>
              <div>
                <label class="label" for="stock-combien">Quantité</label>
                <input type="number" id="stock-combien" min="1" placeholder="2" class="input-field" />
              </div>
            </div>
            <div>
              <label class="label" for="stock-type">Type</label>
              <select id="stock-type" class="select-field">
                <option value="alcool">Alcool</option>
                <option value="soft">Soft</option>
                <option value="drogue">Drogue</option>
                <option value="manger">Manger</option>
              </select>
            </div>
            <div>
              <label class="label mb-2 block">Photo (optionnel)</label>
              <input type="file" id="stock-img" accept="image/*" class="sr-only" />
              <div id="stock-img-drop" class="flex items-center gap-3 p-3 rounded-xl cursor-pointer transition-all" style="border:2px dashed rgba(255,255,255,0.1);background:rgba(255,255,255,0.02);" onclick="document.getElementById('stock-img').click()">
                <img id="stock-img-preview" class="hidden w-10 h-10 rounded-lg object-cover shrink-0" />
                <div id="stock-img-placeholder" class="flex items-center gap-2 text-white/25">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span class="text-sm">Clique pour ajouter une photo</span>
                </div>
                <span id="stock-img-name" class="hidden text-xs text-white/40 truncate"></span>
              </div>
            </div>
            <button id="add-stock-btn" class="w-full py-3 rounded-full text-sm text-black grad-btn">Ajouter</button>
          </div>
        </div>

        <div id="my-stock-list" class="space-y-2">
          {myStock.length === 0 ? (
            <div class="glass-card p-8 rounded-2xl text-center">
              <p class="text-white/30 text-sm">Aucun article dans ton stock.</p>
            </div>
          ) : myStock.map((item) => {
            const types = Array.isArray(item.type) ? item.type : [item.type];
            const firstType = types[0] ?? 'alcool';
            return (
              <div class="stock-item glass-card p-4 rounded-xl flex items-center gap-3" data-id={item.id}>
                {item.img ? (
                  <img src={`${pbUrl}/api/files/stockage/${item.id}/${item.img}`} alt={item.nom} class="w-11 h-11 rounded-lg object-cover shrink-0" />
                ) : (
                  <div class="w-11 h-11 rounded-lg flex items-center justify-center text-xs font-bold shrink-0" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.4);">
                    {TYPE_INITIALS[firstType] ?? '?'}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="font-medium truncate text-white">{item.nom}</div>
                  <div class="text-xs text-white/35 mt-0.5">x{item.combien} · {types.map((t: string) => TYPE_LABELS[t] ?? t).join(', ')}</div>
                </div>
                <button class="delete-btn shrink-0 p-2 rounded-lg text-white/20 hover:text-white/60 hover:bg-white/5 transition-colors" data-id={item.id} aria-label="Supprimer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      </div>

      <!-- STOCK COMMUN -->
      <div>
        <p class="text-xs font-semibold text-white/30 uppercase tracking-widest mb-4">Stock commun</p>
        <div class="mb-5"><StockChart alcool={agg.alcool} soft={agg.soft} drogue={agg.drogue} manger={agg.manger} /></div>

        {breakdown.map((group) => (
          <div class="glass-card p-4 rounded-xl mb-3">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-2 h-2 rounded-full shrink-0" style={`background:${group.shade}`}></div>
              <span class="font-medium text-sm text-white">{group.label}</span>
              <span class="ml-auto text-xs text-white/30">Total : {group.total}</span>
            </div>
            <div class="space-y-2">
              {group.items.map((item) => (
                <div class="flex items-center justify-between text-sm">
                  <span class="text-white/60 truncate flex-1">{item.nom}</span>
                  <div class="flex items-center gap-3 ml-2 shrink-0">
                    <span class="text-white/30">×{item.combien}</span>
                    {user.admin && <span class="text-xs text-white/20">{usersMap[item.qui] ?? '?'}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<div id="__vars" data-pb-url={pbUrl} data-user-id={user.id} data-auth-token={token} aria-hidden="true" style="display:none"></div>
<script src="../js/stock.js"></script>
