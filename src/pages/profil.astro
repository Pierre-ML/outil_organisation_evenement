---
import Layout from '../layouts/Layout.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

const TYPE_LABELS: Record<string, string> = { alcool: 'Alcool', soft: 'Soft', drogue: 'Drogue', manger: 'Manger' };
const TYPE_INITIALS: Record<string, string> = { alcool: 'A', soft: 'S', drogue: 'D', manger: 'M' };

let myStock: any[] = [];
try {
  myStock = await pb.collection('stockage').getFullList({ filter: `qui = "${user.id}"`, sort: '-created' });
} catch {}

const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
const avatarUrl = user.avatar ? `${pbUrl}/api/files/${user.collectionName ?? '_pb_users_auth_'}/${user.id}/${user.avatar}` : null;
---

<Layout title="Mon profil" user={user}>
  <div class="py-8 max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-white">Mon profil</h1>

    <div class="glass-card p-6 rounded-2xl mb-5">
      <div class="flex items-center gap-5 mb-6">
        {avatarUrl ? (
          <img id="avatar-preview" src={avatarUrl} alt={user.name} class="w-20 h-20 rounded-2xl object-cover" style="border:1px solid rgba(255,255,255,.12);" />
        ) : (
          <div id="avatar-preview" class="w-20 h-20 rounded-2xl flex items-center justify-center text-3xl font-black" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.5);">
            {user.name?.[0]?.toUpperCase() ?? 'U'}
          </div>
        )}
        <div>
          <div class="text-xl font-bold text-white">{user.name}</div>
          <div class="text-white/40 text-sm mt-0.5">{user.email}</div>
          {user.admin && (
            <span class="inline-block mt-2 text-xs px-2.5 py-0.5 rounded-full tracking-wider uppercase font-medium" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.45);">
              Administrateur
            </span>
          )}
        </div>
      </div>

      <form id="avatar-form">
        <label class="label mb-2 block">Photo de profil</label>
        <input type="file" id="avatar-input" name="avatar" accept="image/*" class="sr-only" />
        <div id="avatar-drop" class="flex flex-col items-center justify-center gap-3 p-6 rounded-2xl cursor-pointer transition-all" style="border:2px dashed rgba(255,255,255,0.12);background:rgba(255,255,255,0.02);" onclick="document.getElementById('avatar-input').click()">
          <img id="avatar-drop-preview" class="hidden w-24 h-24 rounded-2xl object-cover" style="border:1px solid rgba(255,255,255,0.15);" />
          <div id="avatar-drop-placeholder" class="flex flex-col items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="text-sm text-white/30">Clique ou glisse une image ici</span>
          </div>
          <div id="avatar-drop-name" class="hidden text-xs text-white/40 text-center"></div>
        </div>
        <div id="avatar-error" class="hidden mt-3 text-sm p-3 rounded-xl" style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:rgba(255,255,255,0.65);"></div>
        <div id="avatar-success" class="hidden mt-3 text-sm p-3 rounded-xl" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.8);"></div>
        <button type="submit" id="avatar-btn" class="mt-3 w-full py-2.5 rounded-full text-sm font-medium text-black grad-btn">Mettre à jour la photo</button>
      </form>
    </div>

    <div class="glass-card p-6 rounded-2xl mb-5">
      <h2 class="font-semibold mb-4 text-white">Changer le mot de passe</h2>
      <div id="pwd-error" class="hidden mb-4 p-3 rounded-xl text-sm" style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:rgba(255,255,255,0.65);"></div>
      <div id="pwd-success" class="hidden mb-4 p-3 rounded-xl text-sm" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.8);"></div>
      <div class="space-y-3">
        <div>
          <label class="label" for="pwd-old">Mot de passe actuel</label>
          <input type="password" id="pwd-old" placeholder="••••••••" class="input-field" />
        </div>
        <div>
          <label class="label" for="pwd-new">Nouveau mot de passe</label>
          <input type="password" id="pwd-new" placeholder="••••••••" class="input-field" />
        </div>
        <div>
          <label class="label" for="pwd-confirm">Confirmer le nouveau</label>
          <input type="password" id="pwd-confirm" placeholder="••••••••" class="input-field" />
        </div>
        <button id="pwd-btn" class="px-5 py-2.5 rounded-full text-sm font-medium text-black grad-btn">Changer le mot de passe</button>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl">
      <h2 class="font-semibold mb-5 text-white">Mon stock <span class="text-white/30 font-normal text-sm">({myStock.length} article{myStock.length !== 1 ? 's' : ''})</span></h2>

      {myStock.length === 0 ? (
        <p class="text-white/30 text-sm text-center py-6">Aucun article. Va sur la page Stock pour en ajouter.</p>
      ) : (
        <div class="space-y-2" id="profil-stock-list">
          {myStock.map((item) => {
            const types = Array.isArray(item.type) ? item.type : [item.type];
            const firstType = types[0] ?? 'alcool';
            return (
              <div class="stock-row flex items-center gap-3 p-3 rounded-xl" style="background:rgba(255,255,255,.03);" data-id={item.id}>
                {item.img ? (
                  <img src={`${pbUrl}/api/files/stockage/${item.id}/${item.img}`} alt={item.nom} class="w-10 h-10 rounded-lg object-cover shrink-0" />
                ) : (
                  <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xs font-bold shrink-0" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.35);">
                    {TYPE_INITIALS[firstType] ?? '?'}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-sm truncate text-white">{item.nom}</div>
                  <div class="text-xs text-white/35">x{item.combien} · {types.map((t: string) => TYPE_LABELS[t] ?? t).join(', ')}</div>
                </div>
                <button class="delete-stock-btn p-2 rounded-lg text-white/20 hover:text-white/55 hover:bg-white/5 transition-colors shrink-0" data-id={item.id} aria-label="Supprimer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</Layout>

<div id="__vars" data-pb-url={pbUrl} data-user-id={user.id} data-auth-token={token} aria-hidden="true" style="display:none"></div>
<script src="../js/profil.js"></script>
