---
import Layout from '../layouts/Layout.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

const TYPE_LABELS: Record<string, string> = { alcool: 'Alcool', soft: 'Soft', drogue: 'Drogue', manger: 'Manger' };
const TYPE_INITIALS: Record<string, string> = { alcool: 'A', soft: 'S', drogue: 'D', manger: 'M' };

let myStock: any[] = [];
try {
  myStock = await pb.collection('stockage').getFullList({ filter: `qui = "${user.id}"`, sort: '-created' });
} catch {}

const pbUrl = import.meta.env.POCKETBASE_URL;
const avatarUrl = user.avatar ? `${pbUrl}/api/files/users/${user.id}/${user.avatar}` : null;
---

<Layout title="Mon profil" user={user}>
  <div class="py-8 max-w-2xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 text-white">Mon profil</h1>

    <div class="glass-card p-6 rounded-2xl mb-5">
      <div class="flex items-center gap-5 mb-6">
        {avatarUrl ? (
          <img id="avatar-preview" src={avatarUrl} alt={user.name} class="w-20 h-20 rounded-2xl object-cover" style="border:1px solid rgba(255,255,255,.12);" />
        ) : (
          <div id="avatar-preview" class="w-20 h-20 rounded-2xl flex items-center justify-center text-3xl font-black" style="background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.5);">
            {user.name?.[0]?.toUpperCase() ?? 'U'}
          </div>
        )}
        <div>
          <div class="text-xl font-bold text-white">{user.name}</div>
          <div class="text-white/40 text-sm mt-0.5">{user.email}</div>
          {user.admin && (
            <span class="inline-block mt-2 text-xs px-2.5 py-0.5 rounded-full tracking-wider uppercase font-medium" style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.45);">
              Administrateur
            </span>
          )}
        </div>
      </div>

      <div>
        <label class="label">Changer la photo de profil</label>
        <div class="flex items-center gap-3 flex-wrap">
          <input type="file" id="avatar-input" accept="image/*" class="text-sm text-white/30 cursor-pointer file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium" style="file:background:rgba(255,255,255,.08);file:color:rgba(255,255,255,.55);" />
          <button id="avatar-btn" class="px-5 py-2 rounded-full text-sm font-medium text-black grad-btn">Mettre à jour</button>
        </div>
        <div id="avatar-msg" class="hidden mt-3 text-sm p-3 rounded-lg"></div>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl mb-5">
      <h2 class="font-semibold mb-3 text-white">Mot de passe</h2>
      <div class="flex items-start gap-3 p-4 rounded-xl" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/30 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-white/35 leading-relaxed">
          Les mots de passe sont gérés directement dans PocketBase. Contacte l'admin pour changer le tien.
        </p>
      </div>
    </div>

    <div class="glass-card p-6 rounded-2xl">
      <h2 class="font-semibold mb-5 text-white">Mon stock <span class="text-white/30 font-normal text-sm">({myStock.length} article{myStock.length !== 1 ? 's' : ''})</span></h2>

      {myStock.length === 0 ? (
        <p class="text-white/30 text-sm text-center py-6">Aucun article. Va sur la page Stock pour en ajouter.</p>
      ) : (
        <div class="space-y-2" id="profil-stock-list">
          {myStock.map((item) => {
            const types = Array.isArray(item.type) ? item.type : [item.type];
            const firstType = types[0] ?? 'alcool';
            return (
              <div class="stock-row flex items-center gap-3 p-3 rounded-xl" style="background:rgba(255,255,255,.03);" data-id={item.id}>
                {item.img ? (
                  <img src={`${pbUrl}/api/files/stockage/${item.id}/${item.img}`} alt={item.nom} class="w-10 h-10 rounded-lg object-cover shrink-0" />
                ) : (
                  <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xs font-bold shrink-0" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.35);">
                    {TYPE_INITIALS[firstType] ?? '?'}
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-sm truncate text-white">{item.nom}</div>
                  <div class="text-xs text-white/35">x{item.combien} · {types.map((t: string) => TYPE_LABELS[t] ?? t).join(', ')}</div>
                </div>
                <button class="delete-stock-btn p-2 rounded-lg text-white/20 hover:text-white/55 hover:bg-white/5 transition-colors shrink-0" data-id={item.id} aria-label="Supprimer">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ userId: user.id, pbUrl }}>
  const avatarBtn = document.getElementById('avatar-btn');
  const avatarMsg = document.getElementById('avatar-msg');

  avatarBtn.addEventListener('click', async () => {
    const file = document.getElementById('avatar-input').files?.[0];
    if (!file) { showAvatarMsg('Sélectionne une image.', false); return; }

    avatarBtn.disabled = true;
    avatarBtn.textContent = 'Upload…';
    avatarMsg.classList.add('hidden');

    const fd = new FormData();
    fd.append('avatar', file);

    try {
      const res = await fetch(`${pbUrl}/api/collections/users/records/${userId}`, { method: 'PATCH', body: fd });
      const data = await res.json();
      if (!res.ok) {
        showAvatarMsg(data.message ?? 'Erreur upload.', false);
      } else {
        showAvatarMsg('Photo mise à jour !', true);
        setTimeout(() => window.location.reload(), 800);
      }
    } catch {
      showAvatarMsg('Erreur réseau.', false);
    } finally {
      avatarBtn.disabled = false;
      avatarBtn.textContent = 'Mettre à jour';
    }
  });

  function showAvatarMsg(msg, ok) {
    avatarMsg.textContent = msg;
    avatarMsg.style.cssText = ok
      ? 'background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.8);'
      : 'background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:rgba(255,255,255,.65);';
    avatarMsg.className = 'mt-3 text-sm p-3 rounded-lg';
  }

  document.querySelectorAll('.delete-stock-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const id = e.currentTarget.dataset.id;
      if (!confirm('Supprimer cet article ?')) return;
      try {
        const res = await fetch(`${pbUrl}/api/collections/stockage/records/${id}`, { method: 'DELETE' });
        if (res.ok || res.status === 204) {
          e.currentTarget.closest('.stock-row')?.remove();
        } else {
          alert('Erreur lors de la suppression.');
        }
      } catch {
        alert('Erreur réseau.');
      }
    });
  });
</script>
