---
import Layout from '../layouts/Layout.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

let stockStats = { total: 0, contributors: 0, myTotal: 0 };
try {
  const allStock = await pb.collection('stockage').getFullList<{ qui: string; combien: number }>();
  const uniqueUsers = new Set(allStock.map((s) => s.qui));
  stockStats = {
    total: allStock.reduce((sum, s) => sum + s.combien, 0),
    contributors: uniqueUsers.size,
    myTotal: allStock.filter((s) => s.qui === user.id).reduce((sum, s) => sum + s.combien, 0),
  };
} catch {}

const pbUrl = import.meta.env.POCKETBASE_URL;
const avatarUrl = user.avatar ? `${pbUrl}/api/files/users/${user.id}/${user.avatar}` : null;
---

<Layout title="Dashboard" user={user}>
  <div class="py-8">
    <div class="flex items-center gap-4 mb-10 animate-fade-in">
      {avatarUrl ? (
        <img src={avatarUrl} alt={user.name} class="w-14 h-14 rounded-2xl object-cover shrink-0" style="border: 1px solid rgba(255,255,255,0.12);" />
      ) : (
        <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-xl font-black shrink-0" style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1);">
          {user.name?.[0]?.toUpperCase() ?? 'U'}
        </div>
      )}
      <div>
        <p class="text-white/35 text-xs uppercase tracking-widest mb-1">Bienvenue</p>
        <h1 class="text-2xl sm:text-3xl font-bold text-white">{user.name}</h1>
      </div>
      {user.admin && (
        <span class="ml-auto text-xs font-medium px-3 py-1.5 rounded-full hidden sm:block tracking-wider uppercase" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);">
          Admin
        </span>
      )}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      {[
        { label: 'Mon stock', value: stockStats.myTotal, unit: 'articles' },
        { label: 'Stock commun', value: stockStats.total, unit: 'articles au total' },
        { label: 'Contributeurs', value: stockStats.contributors, unit: 'personnes' },
      ].map((stat) => (
        <div class="glass-card p-6 rounded-2xl">
          <div class="text-xs text-white/35 mb-3 font-medium uppercase tracking-wider">{stat.label}</div>
          <div class="text-5xl font-black text-white mb-1">{stat.value}</div>
          <div class="text-white/30 text-xs">{stat.unit}</div>
        </div>
      ))}
    </div>

    <p class="text-white/30 mb-4 uppercase tracking-widest text-xs font-medium">Accès rapide</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {[
        { href: '/stock', title: 'Mon stock', desc: 'Gère ce que tu ramènes' },
        { href: '/lieux', title: 'Lieu de la soirée', desc: 'Adresse et carte interactive' },
        { href: '/profil', title: 'Mon profil', desc: 'Photo de profil' },
      ].map((card) => (
        <a href={card.href} class="glass-card p-6 rounded-2xl flex items-center justify-between group hover:-translate-y-1 transition-transform duration-200">
          <div>
            <div class="font-semibold text-white">{card.title}</div>
            <div class="text-white/40 text-sm mt-0.5">{card.desc}</div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/20 group-hover:text-white/50 transition-colors shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}

      {user.admin && (
        <a href="/admin" class="p-6 rounded-2xl flex items-center justify-between group hover:-translate-y-1 transition-transform duration-200" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);">
          <div>
            <div class="font-semibold text-white">Administration</div>
            <div class="text-white/40 text-sm mt-0.5">Utilisateurs, lieux, stock global</div>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white/30 group-hover:text-white/60 transition-colors shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  </div>
</Layout>
