---
import Layout from '../layouts/Layout.astro';

const raw = Astro.cookies.get('pb_auth')?.value;
if (raw) return Astro.redirect('/dashboard');

const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
---

<Layout title="Connexion">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="text-center mb-10">
        <a href="/" class="inline-block text-2xl font-black tracking-tight text-white mb-3">SoiréeApp</a>
        <p class="text-white/40 text-sm">Connecte-toi pour rejoindre la soirée</p>
      </div>

      <div class="glass-card-strong p-8 rounded-2xl">
        <div
          id="error-msg"
          class="hidden mb-6 p-4 rounded-xl text-sm"
          style="background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: rgba(255,255,255,0.7);"
        ></div>

        <div class="space-y-5">
          <div>
            <label class="label" for="email">Email</label>
            <input type="email" id="email" autocomplete="email" placeholder="ton@email.com" class="input-field" />
          </div>
          <div>
            <label class="label" for="password">Mot de passe</label>
            <input type="password" id="password" autocomplete="current-password" placeholder="••••••••" class="input-field" />
          </div>
          <button id="login-btn" class="w-full py-3 rounded-full text-sm text-black grad-btn">
            Se connecter
          </button>
        </div>

        <p class="text-center text-xs text-white/25 mt-6">Pas de compte ? Contacte l'admin.</p>
      </div>
    </div>
  </div>
</Layout>

<div id="__vars" data-pb-url={pbUrl} aria-hidden="true" style="display:none"></div>
<script src="../js/login.js"></script>
