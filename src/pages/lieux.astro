---
import Layout from '../layouts/Layout.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

let lieux: any[] = [];

try {
  if (user.admin) {
    lieux = await pb.collection('lieux').getFullList({ sort: 'nom' });
  } else {
    lieux = await pb.collection('lieux').getFullList({ filter: 'reveller = true', sort: 'nom' });
  }
} catch {}

const canSee = user.admin || lieux.length > 0;
const activeLieu = lieux.find((l) => l.active) ?? lieux[0] ?? null;

const pbUrl = import.meta.env.PUBLIC_POCKETBASE_URL;
---

<Layout title="Lieux" user={user}>
  <div class="py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-1 text-white">Lieux</h1>
      <p class="text-white/40">Adresse et carte de la soirée.</p>
    </div>

    {!canSee ? (
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <div class="w-20 h-20 rounded-3xl flex items-center justify-center mb-6" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold mb-3 text-white">Adresse non disponible</h2>
        <p class="text-white/35 max-w-sm leading-relaxed text-sm">L'adresse sera révélée par l'admin au moment voulu.</p>
      </div>
    ) : lieux.length === 0 ? (
      <div class="glass-card p-12 rounded-2xl text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white/15 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h2 class="text-xl font-semibold mb-2 text-white">Aucun lieu enregistré</h2>
        <p class="text-white/35 text-sm">L'admin n'a pas encore ajouté de lieu.</p>
      </div>
    ) : (
      <div class="space-y-8">
        {activeLieu && <MapLeaflet lieux={[activeLieu]} pbUrl={pbUrl} />}

        {/* Lieu actif mis en avant */}
        {activeLieu && (
          <div class="glass-card rounded-2xl overflow-hidden" style="border:1px solid rgba(255,255,255,0.12);">
            {activeLieu.img ? (
              <img src={`${pbUrl}/api/files/lieux/${activeLieu.id}/${activeLieu.img}`} alt={activeLieu.nom} class="w-full h-52 object-cover" />
            ) : (
              <div class="w-full h-52 flex items-center justify-center" style="background:rgba(255,255,255,0.03);">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              </div>
            )}
            <div class="p-6">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <div>
                  <h3 class="font-bold text-xl mb-1 text-white">{activeLieu.nom}</h3>
                  <p class="text-white/40 text-sm flex items-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0 text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {activeLieu.adresse}
                  </p>
                </div>
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(activeLieu.adresse)}`} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-full text-sm font-medium inline-flex items-center gap-2 shrink-0" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);color:rgba(255,255,255,0.6);">
                  Ouvrir dans Maps
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )}

        {/* Autres lieux révélés (si admin) */}
        {user.admin && lieux.filter((l) => l.id !== activeLieu?.id).length > 0 && (
          <div>
            <p class="text-xs font-semibold text-white/25 uppercase tracking-widest mb-3">Autres lieux</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {lieux.filter((l) => l.id !== activeLieu?.id).map((lieu) => (
                <div class="glass-card rounded-2xl overflow-hidden">
                  {lieu.img ? (
                    <img src={`${pbUrl}/api/files/lieux/${lieu.id}/${lieu.img}`} alt={lieu.nom} class="w-full h-36 object-cover" />
                  ) : (
                    <div class="w-full h-36 flex items-center justify-center" style="background:rgba(255,255,255,0.02);">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white/10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                    </div>
                  )}
                  <div class="p-4">
                    <h3 class="font-semibold text-sm mb-0.5 text-white">{lieu.nom}</h3>
                    <p class="text-white/35 text-xs truncate">{lieu.adresse}</p>
                    {!lieu.reveller && (
                      <span class="inline-block mt-2 text-xs px-2 py-0.5 rounded-full" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.25);">Non révélé</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>
