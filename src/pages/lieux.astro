---
import AuthLayout from '../layouts/AuthLayout.astro';
import MapLeaflet from '../components/MapLeaflet.astro';

const auth = Astro.locals.auth!;
const pb = Astro.locals.pb!;
const user = auth.model;

let lieuxVisible = false;
let lieux: any[] = [];

try {
  const settings = await pb.collection('settings').getList(1, 50, {
    filter: 'key = "lieux_visible"',
  });
  lieuxVisible = settings.items.some((s) => s.value === 'true');
} catch {}

const canSee = user.admin || lieuxVisible;

if (canSee) {
  try {
    lieux = await pb.collection('lieux').getFullList({ sort: 'nom' });
  } catch {}
}

const pbUrl = import.meta.env.POCKETBASE_URL;
---

<AuthLayout title="Lieux" user={user}>
  <div class="py-8">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-3">
      <div>
        <h1 class="text-3xl font-bold mb-1">Lieux</h1>
        <p class="text-gray-500">Adresse et carte de la soirée.</p>
      </div>
      {user.admin && (
        <span
          class="text-xs font-medium px-3 py-1.5 rounded-full"
          style="background: rgba(139,92,246,0.15); border: 1px solid rgba(139,92,246,0.3); color: #a78bfa;"
        >
          Visibilité : {lieuxVisible ? 'Activée' : 'Désactivée'}
        </span>
      )}
    </div>

    {!canSee ? (
      <!-- Locked state -->
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <div
          class="w-24 h-24 rounded-3xl flex items-center justify-center text-5xl mb-6"
          style="background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.2);"
        >
          🔒
        </div>
        <h2 class="text-2xl font-bold mb-3">Adresse non disponible</h2>
        <p class="text-gray-500 max-w-sm leading-relaxed">
          L'adresse sera révélée par l'admin au moment voulu. Reviens plus tard !
        </p>
      </div>
    ) : lieux.length === 0 ? (
      <div class="glass-card p-12 rounded-2xl text-center">
        <div class="text-4xl mb-4">📍</div>
        <h2 class="text-xl font-semibold mb-2">Aucun lieu enregistré</h2>
        <p class="text-gray-500 text-sm">L'admin n'a pas encore ajouté de lieu.</p>
      </div>
    ) : (
      <div class="space-y-8">
        <!-- Map -->
        <div>
          <MapLeaflet lieux={lieux} pbUrl={pbUrl} />
        </div>

        <!-- Lieux cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {lieux.map((lieu) => (
            <div class="glass-card rounded-2xl overflow-hidden hover:-translate-y-1 transition-transform duration-200">
              {lieu.img ? (
                <img
                  src={`${pbUrl}/api/files/lieux/${lieu.id}/${lieu.img}`}
                  alt={lieu.nom}
                  class="w-full h-40 object-cover"
                />
              ) : (
                <div class="w-full h-40 flex items-center justify-center text-5xl" style="background: rgba(255,255,255,0.03);">
                  🏠
                </div>
              )}
              <div class="p-5">
                <h3 class="font-semibold text-lg mb-1">{lieu.nom}</h3>
                <p class="text-gray-400 text-sm flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {lieu.adresse}
                </p>
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lieu.adresse)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 mt-4 text-xs text-violet-400 hover:text-violet-300 transition-colors"
                >
                  Ouvrir dans Maps
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</AuthLayout>
