---
import Layout from '../layouts/Layout.astro';
import MapLeaflet from '../components/MapLeaflet.astro';
import PocketBase from 'pocketbase';

const raw = Astro.cookies.get('pb_auth')?.value;
if (!raw) return Astro.redirect('/login');

let token: string;
let user: Record<string, any>;
try {
  const parsed = JSON.parse(raw);
  token = parsed.token;
  user = parsed.record;
  if (!token || !user?.id) throw new Error('invalid');
} catch {
  return Astro.redirect('/login');
}

const pb = new PocketBase(import.meta.env.POCKETBASE_URL);
pb.authStore.save(token, user as any);
if (!pb.authStore.isValid) return Astro.redirect('/login');

let lieuxVisible = false;
let lieux: any[] = [];

try {
  const settings = await pb.collection('settings').getList(1, 50, { filter: 'key = "lieux_visible"' });
  lieuxVisible = settings.items.some((s) => s.value === 'true');
} catch {}

const canSee = user.admin || lieuxVisible;

if (canSee) {
  try {
    lieux = await pb.collection('lieux').getFullList({ sort: 'nom' });
  } catch {}
}

const pbUrl = import.meta.env.POCKETBASE_URL;
---

<Layout title="Lieux" user={user}>
  <div class="py-8">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-3">
      <div>
        <h1 class="text-3xl font-bold mb-1 text-white">Lieux</h1>
        <p class="text-white/40">Adresse et carte de la soirée.</p>
      </div>
      {user.admin && (
        <span class="text-xs font-medium px-3 py-1.5 rounded-full tracking-wider uppercase" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.4);">
          Visibilité : {lieuxVisible ? 'Activée' : 'Désactivée'}
        </span>
      )}
    </div>

    {!canSee ? (
      <div class="flex flex-col items-center justify-center py-24 text-center">
        <div class="w-20 h-20 rounded-3xl flex items-center justify-center mb-6" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold mb-3 text-white">Adresse non disponible</h2>
        <p class="text-white/35 max-w-sm leading-relaxed text-sm">L'adresse sera révélée par l'admin au moment voulu.</p>
      </div>
    ) : lieux.length === 0 ? (
      <div class="glass-card p-12 rounded-2xl text-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white/15 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <h2 class="text-xl font-semibold mb-2 text-white">Aucun lieu enregistré</h2>
        <p class="text-white/35 text-sm">L'admin n'a pas encore ajouté de lieu.</p>
      </div>
    ) : (
      <div class="space-y-8">
        <MapLeaflet lieux={lieux} pbUrl={pbUrl} />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {lieux.map((lieu) => (
            <div class="glass-card rounded-2xl overflow-hidden hover:-translate-y-1 transition-transform duration-200">
              {lieu.img ? (
                <img src={`${pbUrl}/api/files/lieux/${lieu.id}/${lieu.img}`} alt={lieu.nom} class="w-full h-40 object-cover" />
              ) : (
                <div class="w-full h-40 flex items-center justify-center" style="background: rgba(255,255,255,0.03);">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white/12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                  </svg>
                </div>
              )}
              <div class="p-5">
                <h3 class="font-semibold text-lg mb-1 text-white">{lieu.nom}</h3>
                <p class="text-white/40 text-sm flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 shrink-0 text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {lieu.adresse}
                </p>
                <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lieu.adresse)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-4 text-xs text-white/35 hover:text-white/70 transition-colors">
                  Ouvrir dans Maps
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
