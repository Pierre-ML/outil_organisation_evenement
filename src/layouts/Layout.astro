---
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
  user?: Record<string, any>;
}

const { title, description = 'Organise tes soirées entre amis.', user } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — SoiréeApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    {user && <Navbar user={user} />}

    <!-- Animated background -->
    <canvas id="bg-canvas" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>

    <main style="position:relative;z-index:1;" class={user ? 'pt-20 px-4 max-w-6xl mx-auto pb-16' : ''}>
      <slot />
    </main>
  </body>
</html>

<script src="../js/bg.js"></script>
